/*
  SPDX-License-Identifier: GPL-3.0-or-later

  Personal reform_ortho keymap: the i2c-yoba-key64 Planck layout extended to 14x6.
  Planck left half -> columns 0-5, right half -> columns 8-13, on rows 2-5.
*/

#include <behaviors.dtsi>
#if CONFIG_MNT_REFORM_MODE == 0 /* MNT_REFORM_MODE_STANDALONE */
#include <behaviors/reform_menu_standalone.dtsi>
#else
#include <behaviors/reform_menu.dtsi>
#endif
#include <behaviors/reform_sysctrl.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/hid_indicators.h>
#include <dt-bindings/zmk/mouse.h>

// No underglow: the LEDs are indicators, so drop the menu's key-LED items
&reform_menu {
#if CONFIG_MNT_REFORM_MODE == 0 /* MNT_REFORM_MODE_STANDALONE */
    /delete-node/ item1;
    /delete-node/ item2;
    /delete-node/ item3;
    /delete-node/ item4;
    /delete-node/ item5;
    /delete-node/ item6;
#else
    /delete-node/ item4;
    /delete-node/ item5;
    /delete-node/ item6;
    /delete-node/ item7;
    /delete-node/ item8;
    /delete-node/ item9;
#endif
};

#define BASE  0
#define LOWER 1
#define RAISE 2
#define NUM   3
#define HYPER 4

#define ___ &trans

/ {
    // LED 0 is the top one (row 0); unclaimed channels belong to the host
    led_indicators {
        compatible = "mnt,led-indicators";
        led-strip = <&led_strip>;

        caps   { led = <0>; color = <0x400000>; hid-indicators = <HID_INDICATOR_CAPS_LOCK>; };
        num    { led = <0>; color = <0x004000>; hid-indicators = <HID_INDICATOR_NUM_LOCK>; };
        scroll { led = <0>; color = <0x000040>; hid-indicators = <HID_INDICATOR_SCROLL_LOCK>; };
        lower  { led = <1>; color = <0x400000>; layers = <LOWER>; };
        raise  { led = <1>; color = <0x004000>; layers = <RAISE>; };
        numpad { led = <1>; color = <0x000040>; layers = <NUM>; };
    };

    behaviors {
        // QMK-style mod-tap: hold as soon as another key is pressed, or past the tapping term
        qmt: qmk_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Circle: clean tap opens the menu, anything chorded with it is Hyper
        circ: circle_hyper {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            retro-tap;
            bindings = <&mo>, <&reform_menu>;
        };

        // Second tap within the term toggles Caps Lock; a single tap does nothing
        dbl_caps: double_tap_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&none>, <&caps_unshifted>;
        };
    };

    macros {
        // Caps Lock without Shift: drop the Shift sft_cap already pressed, then tap Caps
        caps_unshifted: caps_unshifted {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&macro_release &kp LSHFT>, <&macro_tap &kp CAPS>;
        };

        // Shift goes down at once (so Shift+click works); double tap also toggles Caps Lock
        sft_cap: shift_caps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_press &kp LSHFT &dbl_caps>
                , <&macro_pause_for_release>
                , <&macro_release &kp LSHFT &dbl_caps>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Esc    F1  F2  F3  F4  F5 | F11  F12 | F6  F7  F8  F9  F10  Circ/Hyper
        // Alt    1   2   3   4   5  |  -    =  | 6   7   8   9   0    PgUp
        // Tab    Q   W   E   R   T  |  [    ]  | Y   U   I   O   P    PgDn
        // Ct/Tab A   S   D   F   G  |  (    )  | H   J   K   L   ;    '
        // Sh/Cap Z   X   C   V   B  |  `    \  | N   M   ,   .   /    Sh/Ent
        // Cmp/L3 Ins Del GUI Lwr Bsp| Spc  Spc | Spc Rse Left Down Up Right
        base {
            display-name = "Base";
            bindings = <
&kp ESC           &kp F1    &kp F2    &kp F3    &kp F4    &kp F5     &kp F11    &kp F12    &kp F6    &kp F7      &kp F8    &kp F9    &kp F10   &circ HYPER 0
&kp LALT          &kp N1    &kp N2    &kp N3    &kp N4    &kp N5     &kp MINUS  &kp EQUAL  &kp N6    &kp N7      &kp N8    &kp N9    &kp N0    &kp PG_UP
&kp TAB           &kp Q     &kp W     &kp E     &kp R     &kp T      &kp LBKT   &kp RBKT   &kp Y     &kp U       &kp I     &kp O     &kp P     &kp PG_DN
&qmt LCTRL TAB    &kp A     &kp S     &kp D     &kp F     &kp G      &kp LPAR   &kp RPAR   &kp H     &kp J       &kp K     &kp L     &kp SEMI  &kp SQT
&sft_cap          &kp Z     &kp X     &kp C     &kp V     &kp B      &kp GRAVE  &kp BSLH   &kp N     &kp M       &kp COMMA &kp DOT   &kp FSLH  &qmt RSHFT ENTER
&qmt RALT K_APP   &kp INS   &kp DEL   &kp LGUI  &mo LOWER &kp BSPC   &kp SPACE  &kp SPACE  &kp SPACE &mo RAISE   &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT
            >;
        };

        // Planck Lower; its F-key row and F11/F12 moved to the base F-row
        lower {
            display-name = "Lower";
            bindings = <
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       &kp TILDE &kp GRAVE &kp DLLR  &kp AT    &kp BSLH   ___        ___        &kp CARET &kp PRCNT   &kp STAR  &kp C_BRI_UP &kp C_BRI_DN ___
___       &kp EXCL  &kp HASH  &kp LT    &kp EQUAL &kp PIPE   ___        ___        &kp AMPS  &kp PLUS    &kp GT    &kp C_VOL_UP &kp C_VOL_DN ___
___       ___       ___       ___       ___       &kp DEL    ___        ___        &kp ENTER ___         &kp HOME  &kp PG_DN &kp PG_UP &kp END
            >;
        };

        // Planck Raise; its digit row moved to the base digit row
        raise {
            display-name = "Raise";
            bindings = <
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       &kp LBRC  &kp LBKT  &kp LPAR  &kp SQT   &kp MINUS  ___        ___        &kp UNDER &kp DQT     &kp RPAR  &kp RBKT  &kp RBRC  ___
___       &kp C_PREV &kp C_PP &kp C_STOP &kp C_NEXT &kp C_MUTE ___      ___        ___       &mkp MCLK   ___       &kp LBKT &kp RBKT &kp LS(ENTER)
___       ___       ___       ___       ___       &kp DEL    ___        ___        &kp ENTER ___         &kp HOME  &kp PG_DN &kp PG_UP &kp END
            >;
        };

        // Planck Num toggle
        num {
            display-name = "Num";
            bindings = <
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
___       ___       ___       ___       ___       &kp KP_NUM ___ ___   &kp KP_N7 &kp KP_N8   &kp KP_N9 &kp KP_PLUS &kp KP_SLASH ___
___       ___       ___       ___       ___       ___        ___        ___        &kp KP_N4 &kp KP_N5   &kp KP_N6 &kp KP_MINUS &kp KP_MULTIPLY ___
___       ___       ___       ___       ___       ___        ___        ___        &kp KP_N1 &kp KP_N2   &kp KP_N3 &kp KP_N0 &kp KP_DOT ___
___       ___       ___       ___       ___       ___        ___        ___        ___       ___         ___       ___       ___       ___
            >;
        };

        // MNT stock Hyper: screen brightness, media and volume on the F-keys, arrows -> Home/PgDn/PgUp/End;
        // plus the menu's reset (R); bootloader is menu-only
        hyper {
            display-name = "Hyper";
            bindings = <
___              &kp C_BRI_DN     &kp C_BRI_UP     ___              ___              ___              &kp C_VOL_DN     &kp C_VOL_UP     ___              &kp C_PREV       &kp C_PP         &kp C_NEXT       &kp C_MUTE       ___
___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___
___              ___              ___              ___              &sys_reset       ___              ___              ___              ___              ___              ___              ___              ___              ___
___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___
___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___              ___
___              ___              ___              ___              ___              ___              ___              ___              ___              ___              &kp HOME         &kp PG_DN        &kp PG_UP        &kp END
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };
    };
};
